---
import BaseLayout from "../layout/BaseLayout.astro";
import Tracker from "../components/tracker/Tracker.tsx";
---

<BaseLayout
	title="On Deck - an initiative tracker for D&D"
	description="Initiative tracker"
>
<h1 class="page-title">On Deck</h1>
	<p class="title-tag">
		An initiative tracker for D&D 5e
	</p>

	<Tracker client:only="react" />

	<section
		class="how-to-section"
		aria-labelledby="how-to-title"
	>
	<h2 id="how-to-title">How to use the initiative tracker</h2>
		<ol>
			<li>
				Start typing a character or monster name in one of the name fields
				<ul>
					<li>If the name matches a monster, you can use the autocomplete options to fill out its HP and AC</li>
					<li>For player characters or monsters not found, fill out HP and AC yourself</li>
				</ul>
			</li>
			<li>
				Click the "Add new" button if you need more rows for characters and monsters
				<ul>
					<li>If you have empty rows, click the trash icon to delete them</li>
				</ul>
			</li>
			<li>Fill out the initiative for each character and monster</li>
			<li>Click "Sort" button to sort all participants by turn order</li>
			<li>
				Click "Next turn" button during combat to advance the turn
				<ul>
					<li>On Deck automagically keeps track of rounds for you</li>
				</ul>
			</li>
			<li>You can either manually change HP as combat progresses, or click the plus/minus button to enter the amount of HP the character takes as damage or healing</li>
		</ol>
	</section>
</BaseLayout>

<style lang="scss">
	.page-title {
		font-size: 4em;
	}

	.how-to-section {
		margin-top: var(--margin-xl);
	}

	#how-to-title {
		font-size: 2.25em;
		margin: 0;
	}

	ol {
		margin-block-start: 1em;
    margin-block-end: 1em;
    padding-inline-start: var(--margin-xl);
		margin: var(--margin-lg);
		margin-top: var(--margin-sm);
	}

	ol > li {
		margin-bottom: var(--margin-sm);
	}

	@media (max-width: 600px) {
    .page-title {
      display: none;
    }

		.title-tag {
      display: none;
    }
  }
</style>